{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=atomic_habits;Username=postgres;Password=postgres"
  },
  "Database": {
    "Provider": "PostgreSql",
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "AtomicHabits",
    "Audience": "AtomicHabits.Mobile",
    "SigningKey": "dev-only-change-me-atomic-habits-signing-key-32-plus",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
